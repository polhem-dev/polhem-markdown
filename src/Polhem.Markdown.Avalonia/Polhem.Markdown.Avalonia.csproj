<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A Markdown viewer control for Avalonia, rendering the same model as Polhem.Markdown.Blazor so both front ends show a text the same way.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest Avalonia version the viewer supports, not the newest: it becomes the minimum for every consumer. -->
    <PackageReference Include="Avalonia" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Markdown.Avalonia.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packed as an exact version: PolhemMarkdownExactProjectReferenceVersions in src/Directory.Build.targets. -->
    <ProjectReference Include="..\Polhem.Markdown\Polhem.Markdown.csproj" />
  </ItemGroup>

</Project>
