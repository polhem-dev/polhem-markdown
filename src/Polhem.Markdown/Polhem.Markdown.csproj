<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Parses Markdown with Markdig into the model that the Polhem.Markdown viewers render, and applies one safety policy for both: raw HTML shown as text, links checked against allowed schemes.</Description>
    <!-- The viewers run on iOS, Android and WebAssembly. The trim and AOT analyzers turn every incompatible call into a
         build error, and tests/Polhem.Markdown.AotSmoke runs the parser after a Native AOT publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <!-- MarkdownHtml styles its HTML with the Blazor viewer's own stylesheet, embedded here so that the two cannot drift
       apart (see Output/ViewerStyleSheet.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Polhem.Markdown.Blazor\wwwroot\polhem-markdown.css"
                      Link="Output\polhem-markdown.css"
                      LogicalName="Polhem.Markdown.Output.polhem-markdown.css" />
  </ItemGroup>

  <!-- The model is internal so that it can change without a breaking change; the viewers render it, so they see it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Polhem.Markdown.Avalonia" />
    <InternalsVisibleTo Include="Polhem.Markdown.Blazor" />
    <InternalsVisibleTo Include="Polhem.Markdown.UnitTests" />
    <InternalsVisibleTo Include="Polhem.Markdown.AotSmoke" />
    <InternalsVisibleTo Include="Polhem.Markdown.Avalonia.UnitTests" />
    <InternalsVisibleTo Include="Polhem.Markdown.Blazor.UnitTests" />
  </ItemGroup>

</Project>
