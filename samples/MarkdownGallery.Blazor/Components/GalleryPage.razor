@page "/"
@implements IAsyncDisposable

<div class="gallery @(_dark ? "dark" : "")">
    <div class="bar">
        <label><input type="checkbox" @bind="_dark" /> Dark</label>
        <label><input type="checkbox" @bind="_edit" /> Edit</label>
        <label><input type="checkbox" @bind="_showOutline" /> Outline</label>
        <button type="button" @onclick="Replay">Replay</button>
        <span class="status">@_status</span>
    </div>
    <div class="body @(_showOutline ? "with-outline" : "")">
    @if (_showOutline)
    {
        @* The outline lists the shown viewer's headings, scrolls it to the one picked, and marks the one in view: the last
           heading that starts at or before the source at the top of the view. *@
        <nav class="frame outline" aria-label="Outline">
            @foreach (var heading in _headings)
            {
                <button type="button" class="@(heading == _currentHeading ? "current" : "")" style="padding-left: @((heading.Level - 1) * 12 + 8)px"
                        @onclick="() => GoToHeading(heading)">@heading.Text</button>
            }
        </nav>
    }
    @if (_edit)
    {
        @* The side under the pointer or with the focus leads the scrolling, so the other one, scrolled to match, does not
           scroll it back. *@
        <div class="split">
            <div class="frame source" @onpointerenter="() => _leader = Pane.Editor" @onfocusin="() => _leader = Pane.Editor">
                <MarkdownEditor @ref="_editor" Markdown="@_markdown" MarkdownChanged="Edited" aria-label="Markdown source"
                                FirstVisibleSourceOffsetChanged="EditorScrolled" />
            </div>
            <div class="frame viewer-frame preview" @onpointerenter="() => _leader = Pane.Viewer" @onfocusin="() => _leader = Pane.Viewer">
                <MarkdownViewer @ref="_viewer" Markdown="@_preview" Options="_options" OnLinkActivated="OnLinkActivated"
                                FirstVisibleSourceOffsetChanged="ViewerScrolled" OnSourceRequested="GoToSource"
                                OnHeadingsChanged="HeadingsChanged" />
            </div>
        </div>
    }
    else
    {
        <div class="frame viewer-frame">
            <MarkdownViewer @ref="_viewer" Markdown="@_markdown" Options="_options" OnLinkActivated="OnLinkActivated"
                            FirstVisibleSourceOffsetChanged="FollowScroll" OnHeadingsChanged="HeadingsChanged" />
        </div>
    }
    </div>
</div>

@code {
    private const int ReplayChunk = 12;

    private readonly MarkdownOptions _options = CreateOptions();
    private string _markdown = MarkdownGallery.SampleText.Markdown;

    // What the preview shows while editing: the text a moment after typing stops, so the viewer does not rebuild on
    // every key.
    private string _preview = MarkdownGallery.SampleText.Markdown;
    private CancellationTokenSource? _previewDelay;
    private string? _status;
    private bool _dark;
    private bool _edit;
    private MarkdownEditor? _editor;
    private MarkdownViewer? _viewer;
    private Pane _leader = Pane.Editor;
    private bool _showOutline;
    private IReadOnlyList<MarkdownHeading> _headings = [];
    private MarkdownHeading? _currentHeading;

    // Until the view scrolls, the top of the text is in view.
    private void HeadingsChanged(IReadOnlyList<MarkdownHeading> headings)
    {
        _headings = headings;
        if (_currentHeading is null || !headings.Contains(_currentHeading))
        {
            _currentHeading = headings.FirstOrDefault();
        }
    }

    // At the end of the text the last headings cannot reach the top of the view, so the heading at the top would replace
    // one just picked there at once; a picked heading stays marked until the next scroll after the one it caused.
    private DateTime _pickedAt;

    private void FollowScroll(int offset)
    {
        if (DateTime.UtcNow - _pickedAt > TimeSpan.FromMilliseconds(300))
        {
            _currentHeading = _headings.LastOrDefault(heading => heading.SourceOffset <= offset);
        }
    }

    private async Task GoToHeading(MarkdownHeading heading)
    {
        if (_viewer is not null)
        {
            _leader = Pane.Viewer;
            _currentHeading = heading;
            _pickedAt = DateTime.UtcNow;
            await _viewer.ScrollToHeadingAsync(heading.Id);
        }
    }

    private enum Pane
    {
        Editor,
        Viewer,
    }

    private async Task EditorScrolled(int offset)
    {
        if (_leader == Pane.Editor && _viewer is not null)
        {
            await _viewer.ScrollToSourceOffsetAsync(offset);
        }
    }

    private async Task ViewerScrolled(int offset)
    {
        FollowScroll(offset);
        if (_leader == Pane.Viewer && _editor is not null)
        {
            await _editor.ScrollToSourceOffsetAsync(offset);
        }
    }

    // Ctrl or Command and a click in the preview: the editor shows that text and takes the focus.
    private async Task GoToSource(MarkdownSourceRequestedEventArgs e)
    {
        if (_editor is not null)
        {
            _leader = Pane.Editor;
            await _editor.SetCaretOffsetAsync(e.SourceOffset);
            await _editor.ScrollToSourceOffsetAsync(e.SourceOffset);
            await _editor.FocusAsync();
        }
    }

    private async Task Edited(string text)
    {
        _markdown = text;
        if (_previewDelay is not null)
        {
            await _previewDelay.CancelAsync();
            _previewDelay.Dispose();
        }
        _previewDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(150, _previewDelay.Token);
        }
        catch (TaskCanceledException)
        {
            // Another edit came; its delay updates the preview.
            return;
        }
        _preview = _markdown;
    }

    private CancellationTokenSource? _replay;

    private static MarkdownOptions CreateOptions()
    {
        var options = new MarkdownOptions();
        options.AllowedLinkSchemes.Add("polhem");
        return options;
    }

    private void OnLinkActivated(MarkdownLinkActivatedEventArgs e) => _status = "Opened " + e.Uri;

    private async Task Replay()
    {
        await StopReplayAsync();
        _replay = new CancellationTokenSource();
        var token = _replay.Token;
        var text = MarkdownGallery.SampleText.Markdown;
        for (var shown = 0; shown < text.Length && !token.IsCancellationRequested;)
        {
            shown = Math.Min(shown + ReplayChunk, text.Length);
            _markdown = _preview = text[..shown];
            StateHasChanged();
            await Task.Delay(30, CancellationToken.None);
        }
    }

    // The loop of an earlier replay may still be running; reading the token of a disposed source is safe and reports it
    // as cancelled, so that loop ends at its next step.
    private async Task StopReplayAsync()
    {
        if (_replay is not null)
        {
            await _replay.CancelAsync();
            _replay.Dispose();
            _replay = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await StopReplayAsync();
        _previewDelay?.Dispose();
    }
}
