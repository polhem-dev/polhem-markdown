@page "/"
@implements IAsyncDisposable

<div class="gallery @(_dark ? "dark" : "")">
    <div class="bar">
        <label><input type="checkbox" @bind="_dark" /> Dark</label>
        <label><input type="checkbox" @bind="_edit" /> Edit</label>
        <button type="button" @onclick="Replay">Replay</button>
        <span class="status">@_status</span>
    </div>
    @if (_edit)
    {
        @* The side under the pointer or with the focus leads the scrolling, so the other one, scrolled to match, does not
           scroll it back. *@
        <div class="split">
            <div class="source" @onpointerenter="() => _leader = Pane.Editor" @onfocusin="() => _leader = Pane.Editor">
                <MarkdownEditor @ref="_editor" @bind-Markdown="_markdown" aria-label="Markdown source"
                                FirstVisibleSourceOffsetChanged="EditorScrolled" />
            </div>
            <div class="preview" @onpointerenter="() => _leader = Pane.Viewer" @onfocusin="() => _leader = Pane.Viewer">
                <MarkdownViewer @ref="_viewer" Markdown="@_markdown" Options="_options" OnLinkActivated="OnLinkActivated"
                                FirstVisibleSourceOffsetChanged="ViewerScrolled" OnSourceRequested="GoToSource" />
            </div>
        </div>
    }
    else
    {
        <MarkdownViewer Markdown="@_markdown" Options="_options" OnLinkActivated="OnLinkActivated" />
    }
</div>

@code {
    private const int ReplayChunk = 12;

    private readonly MarkdownOptions _options = CreateOptions();
    private string _markdown = MarkdownGallery.SampleText.Markdown;
    private string? _status;
    private bool _dark;
    private bool _edit;
    private MarkdownEditor? _editor;
    private MarkdownViewer? _viewer;
    private Pane _leader = Pane.Editor;

    private enum Pane
    {
        Editor,
        Viewer,
    }

    private async Task EditorScrolled(int offset)
    {
        if (_leader == Pane.Editor && _viewer is not null)
        {
            await _viewer.ScrollToSourceOffsetAsync(offset);
        }
    }

    private async Task ViewerScrolled(int offset)
    {
        if (_leader == Pane.Viewer && _editor is not null)
        {
            await _editor.ScrollToSourceOffsetAsync(offset);
        }
    }

    // Ctrl or Command and a click in the preview: the editor shows that text and takes the focus.
    private async Task GoToSource(MarkdownSourceRequestedEventArgs e)
    {
        if (_editor is not null)
        {
            _leader = Pane.Editor;
            await _editor.SetCaretOffsetAsync(e.SourceOffset);
            await _editor.ScrollToSourceOffsetAsync(e.SourceOffset);
            await _editor.FocusAsync();
        }
    }
    private CancellationTokenSource? _replay;

    private static MarkdownOptions CreateOptions()
    {
        var options = new MarkdownOptions();
        options.AllowedLinkSchemes.Add("polhem");
        return options;
    }

    private void OnLinkActivated(MarkdownLinkActivatedEventArgs e) => _status = "Opened " + e.Uri;

    private async Task Replay()
    {
        await StopReplayAsync();
        _replay = new CancellationTokenSource();
        var token = _replay.Token;
        var text = MarkdownGallery.SampleText.Markdown;
        for (var shown = 0; shown < text.Length && !token.IsCancellationRequested;)
        {
            shown = Math.Min(shown + ReplayChunk, text.Length);
            _markdown = text[..shown];
            StateHasChanged();
            await Task.Delay(30, CancellationToken.None);
        }
    }

    // The loop of an earlier replay may still be running; reading the token of a disposed source is safe and reports it
    // as cancelled, so that loop ends at its next step.
    private async Task StopReplayAsync()
    {
        if (_replay is not null)
        {
            await _replay.CancelAsync();
            _replay.Dispose();
            _replay = null;
        }
    }

    public async ValueTask DisposeAsync() => await StopReplayAsync();
}
