<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Polhem.Markdown Gallery</title>
    <link rel="stylesheet" href="@Assets["_content/Polhem.Markdown.Blazor/polhem-markdown.css"]" />
    <style>
        body { margin: 0; font-family: system-ui, sans-serif; font-size: 15px; }
        .gallery { min-height: 100vh; box-sizing: border-box; padding: 8px 16px 24px; background: #fff; color: #1c1f23; }
        .gallery.dark { background: #16161a; color: #f9f9f9; color-scheme: dark; }
        .bar { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
        .status { opacity: 0.7; }
    </style>
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
